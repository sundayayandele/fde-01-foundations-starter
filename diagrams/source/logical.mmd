%% Logical view: training and serving share one normalisation and one bundle format.
flowchart LR
  subgraph Training
    data[Pinned dataset] --> split[Stratified split + leakage removal]
    split --> fit[Fit: baseline / MLP / transformer]
    fit --> eval[Evaluate: macro-F1, confusions, latency, memory, cost]
    eval --> bundle[(Bundle + meta.json)]
  end
  subgraph Serving
    req[Request text] --> norm[normalise]
    norm --> proba[predict_proba]
    bundle --> proba
    proba --> route[route: auto or human]
    route --> resp[Response + metrics]
  end
