%% Enterprise view (TOGAF business, application and technology layers).
flowchart TB
  subgraph Business["Business layer"]
    team[Complaints operations] --> process[Triage incoming complaints to the right queue]
    process --> outcome[Faster first response; people focus on unclear cases]
  end
  subgraph Application["Application layer"]
    router[Complaint router API + UI]
    cases[Case management queues]
    ingest[fde-00 ingestion service]
  end
  subgraph Technology["Technology layer"]
    desk[Desktops: Docker, Podman, Rancher]
    k8s[Kubernetes / OpenShift]
    cloud[AWS Fargate · Azure Container Apps · GCP Cloud Run]
  end
  process --> router --> cases
  ingest -->|training data| router
  router --> desk
  router --> k8s
  router --> cloud
